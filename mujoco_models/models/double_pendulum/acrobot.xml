<mujoco model="acrobot">
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>
    <option>
        <flag energy="enable"/>
    </option>

    <default>
        <joint damping="0.05"/>
        <general dyntype="none" gaintype="fixed" biastype="none" dynprm="1 0 0" gainprm="1 0 0" biasprm="0 0 0"/>
    </default>

    <worldbody>
        <body name="base_link" pos="0 0 0">
            <!--<geom type="box" size="0.05 0.05 0.05" rgba="0.6 0.6 0.6 1"/>-->

            <body name="link_1" pos="0 0 0">
                <joint name="joint_1" type="hinge" axis="0 1 0" range="-6.28 6.28"/>
                <geom type="capsule" fromto="0 0 0 0 0 -0.7" size="0.03" rgba="0.2 0.4 0.8 1"/>

                <body name="joint_2_link" pos="0 0 -0.7">
                    <inertial pos="0 0 0" mass="0.02" diaginertia="1e-4 1e-4 1e-4"/>

                    <body name="link_2" pos="0 0 0">
                        <joint name="joint_2" type="hinge" axis="0 1 0" range="-12.56 12.56"/>
                        <geom type="capsule" fromto="0 0 0 0 0 -0.7" size="0.025" rgba="0.2 0.7 0.4 1"/>
                    <site name="tcp_site" pos="0 0 -0.7" size="0.02" rgba="0.9 0.6 0.1 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <general name="joint_2_actuator" joint="joint_2" ctrlrange="-20.0 20.0" ctrllimited="true"/>
    </actuator>

    <keyframe>
        <key name="home" qpos="0.12 -0.08" ctrl="0"/>
    </keyframe>
</mujoco>
