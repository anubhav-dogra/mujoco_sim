<mujoco model="pendulum">
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

    <default>
        <joint damping="0.05"/>
        <general gaintype="fixed" biastype="affine" gainprm="100.0" biasprm="0 -100.0 -10.0"/>
    </default>

    <worldbody>
        <body name="base_link" pos="0 0 0">
            <geom type="box" size="0.05 0.05 0.05" rgba="0.6 0.6 0.6 1"/>

            <body name="pendulum_link" pos="0 0 0">
                <joint name="pendulum_joint" type="hinge" axis="0 1 0" range="-3.14159 3.14159"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.9" size="0.03" rgba="0.2 0.4 0.8 1"/>

                <body name="pendulum_ft_link" pos="0 0 0.9">
                    <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
                    <site name="pendulum_ft_site" pos="0 0 0" size="0.02" rgba="1 0 0 1"/>

                    <body name="pendulum_tip_link" pos="0 0 0.1">
                        <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
                        <geom type="sphere" size="0.05" rgba="0.9 0.3 0.3 1"/>
                        <site name="pendulum_tip" pos="0 0 0" size="0.02" rgba="1 0.8 0 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <general name="pendulum_joint_actuator" joint="pendulum_joint" ctrlrange="-3.14159 3.14159" ctrllimited="true"/>
    </actuator>

    <sensor>
        <force name="pendulum_tip_force" site="pendulum_ft_site"/>
        <torque name="pendulum_tip_torque" site="pendulum_ft_site"/>
    </sensor>

    <keyframe>
        <key name="home" qpos="0.1" ctrl="0"/>
    </keyframe>
</mujoco>
