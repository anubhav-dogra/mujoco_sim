<mujoco model="pendulum">
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

    <default>
        <joint damping="0.05"/>
        <general gaintype="fixed" biastype="affine" gainprm="100.0" biasprm="0 -100.0 -10.0"/>
    </default>

    <worldbody>
        <body name="base_link" pos="0 0 0">
            <geom type="box" size="0.05 0.05 0.05" rgba="0.6 0.6 0.6 1"/>

            <body name="pendulum_link" pos="0 0 0">
                <joint name="pendulum_joint" type="hinge" axis="0 1 0" range="-3.14159 3.14159"/>
                <geom type="capsule" fromto="0 0 0 0 0 1.0" size="0.03" rgba="0.2 0.4 0.8 1"/>
                <site name="pendulum_tip" pos="0 0 1.0" size="0.02" rgba="1 0 0 1"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <general name="pendulum_joint_actuator" joint="pendulum_joint" ctrlrange="-3.14159 3.14159" ctrllimited="true"/>
    </actuator>

    <keyframe>
        <key name="home" qpos="0.1" ctrl="0"/>
    </keyframe>
</mujoco>
