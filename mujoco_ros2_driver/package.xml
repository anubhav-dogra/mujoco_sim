<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_ros2_driver</name>
  <version>0.0.0</version>
  <description>ros2_control hardware plugin for driving MuJoCo simulations through MujocoSimCore.</description>
  <maintainer email="anubhavdograa@gmail.com">Anubhav Dogra</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>mujoco_core</depend>
  <depend>mujoco_viewer</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
